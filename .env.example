# Optional. If unset, a key is created in the data volume on first boot.
# Losing this value makes an existing encrypted session file unreadable.
YTTV_EPG_SECRET=

# How other machines reach this container (APITuner, Channels, browsers).
# Leave as localhost (or unset) to use the host you opened the dashboard with.
# PUBLIC_BASE_URL=http://192.168.1.10:8095

TZ=America/New_York
# Default until a lane count is saved in the dashboard.
LANE_COUNT=128
START_CHANNEL=9100
REFRESH_SECONDS=60
FULL_MINE_SECONDS=300
CHROME_KEEPALIVE_SECONDS=14400
MINE_CONCURRENCY=4
XMLTV_INCLUDE_SUBTITLE=false
# Initial default only; dashboard changes persist in the catalog.
XMLTV_LIVE_ON_AIR=false
# Initial default only; change the saved preference on the dashboard afterwards.
HIDE_SPANISH=false
# Optional JSON station-to-logo URL overrides inside the container; restart after editing.
STATION_LOGOS_FILE=/data/station-logos.json
# Comma-separated sports to hide until you change them on the dashboard.
# HIDDEN_SPORTS=Volleyball,Field Hockey,Water Polo
# Comma-separated channel families to hide until you change them on the dashboard.
# HIDDEN_CHANNELS=ESPN+,NBC Sports Extra
# MAX_HUBS=16
# EPG_PAGES=24
# HUB_PAGES=20

# Optional lock on the dashboard / session import page only.
# Resolver, XMLTV, and M3U stay open for APITuner.
ADMIN_USER=
ADMIN_PASSWORD=

# In-container Chromium on a virtual display (sign in once at :8095 or :7900).
ENABLE_CHROME=1
# NOVNC_PUBLIC_URL=http://192.168.1.10:7900/vnc.html?autoconnect=true&resize=scale


# Collect diagnostic game details only; never excludes replays or changes Live/New.
DETAIL_EVIDENCE=true
